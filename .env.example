# OpenAI. Used only for ambiguous catalog choices and the prose under each fix.
# The score itself is deterministic and does not call a model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Terse. Local `terse actor dev` works without these.
# After `terse deploy`, set the printed URL and a key from the Terse app (API keys).
TERSE_ACTOR_URL=http://127.0.0.1:7100/v1/projects/local/actors
TERSE_API_KEY=
# Optional. When set on the local actor server, clients must send the same value as TERSE_API_KEY.
TERSE_ACTOR_SECRET=

# Agent Relay / Relaycast.
# Leave RELAY_WORKSPACE_KEY empty to create a workspace at startup and print the key.
# SDK 15.0.1 defaults observer traffic at https://cast.agentrelay.com.
# Docs also list https://armadillo.agentrelay.com for ar_ws_* keys.
# Local fallback: run @relaycast/engine and set RELAY_BASE_URL=http://127.0.0.1:8787
RELAY_WORKSPACE_KEY=
RELAY_BASE_URL=
RELAY_OBSERVER_TOKEN=

# Dev store. It is password-gated and the password cannot be turned off.
# The password lives on another machine. Leave it empty to run SHOP_MODE=fixture.
SHOP_URL=https://aiconvertit-demo.myshopify.com
# Fixer writes through the Dev Dashboard client-credentials grant.
# POST https://{shop}/admin/oauth/access_token
# grant_type=client_credentials, client_id, client_secret.
# The access token is cached in memory and refreshed before expires_in.
# Leave both empty to dry-run the fixer without writing.
# Verified scopes: write_products,write_legal_policies
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Set to on only when `terse actor dev` is running. The dashboard otherwise
# runs the same Fixer engine in-process.
FIXER_ACTOR=
SHOP_STOREFRONT_PASSWORD=
# live | fixture. Fixture uses the recorded Ghost 18 catalog and needs no keys.
SHOP_MODE=fixture
SHOP_FIXTURE=before

# Stretch. Not required for the MVP audit path.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPERSERVE_API_KEY=
FREESTYLE_API_KEY=
